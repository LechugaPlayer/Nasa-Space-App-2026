    "@capacitor/share": "8.0.3",
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
